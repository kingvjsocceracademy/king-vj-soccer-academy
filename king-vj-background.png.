

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>KING VJ SOCCER ACADEMY</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #06150b;
    color: white;
}

/* HOME HERO */
.hero {
    min-height: 100vh;
    background:
        linear-gradient(
            rgba(0, 15, 8, 0.45),
            rgba(0, 15, 8, 0.75)
        ),
        url("king-vj-background.png");

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    display: flex;
    flex-direction: column;
}

/* NAVIGATION */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
    background: rgba(0, 0, 0, 0.25);
}

.logo {
    font-size: 24px;
    font-weight: 900;
    color: #00ff55;
}

.logo span {
    color: white;
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    text-decoration: none;
    color: white;
    font-weight: bold;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #00ff55;
}

/* HERO CONTENT */
.hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 8%;
    max-width: 1000px;
}

.hero-content h1 {
    font-size: clamp(40px, 7vw, 85px);
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
}

.hero-content h1 span {
    color: #00ff55;
}

.hero-content p {
    font-size: 20px;
    margin-top: 25px;
    line-height: 1.7;
    max-width: 650px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-top: 35px;
}

.btn {
    padding: 16px 30px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.btn-primary {
    background: #00ff55;
    color: #001b09;
}

.btn-primary:hover {
    background: white;
    transform: translateY(-3px);
}

.btn-outline {
    border: 2px solid white;
    color: white;
}

.btn-outline:hover {
    background: white;
    color: #001b09;
}

/* MOBILE RESPONSIVE */
@media (max-width: 768px) {
    .navbar {
        flex-direction: column;
        gap: 20px;
    }

    .nav-links {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero-content {
        padding: 60px 6%;
        align-items: center;
        text-align: center;
    }

    .hero-content p {
        font-size: 16px;
    }

    .hero-buttons {
        justify-content: center;
    }
}
</style>
</head>

<body>

<section class="hero">

    <nav class="navbar">
        <div class="logo">
            KING VJ <span>SOCCER ACADEMY</span>
        </div>

        <div class="nav-links">
            <a href="index.html">Home</a>
            <a href="about.html">About</a>
            <a href="programs.html">Programs</a>
            <a href="contact.html">Contact</a>
        </div>
    </nav>

    <div class="hero-content">

        <h1>
            DEVELOPING<br>
            <span>CHAMPIONS</span>
        </h1>

        <p>
            Welcome to KING VJ SOCCER ACADEMY.
            We develop young football talents through
            discipline, teamwork, skill, and excellence.
            Your football journey starts here!
        </p>

        <div class="hero-buttons">
            <a href="register.html" class="btn btn-primary">
                JOIN OUR ACADEMY
            </a>

            <a href="about.html" class="btn btn-outline">
                DISCOVER MORE
            </a>
        </div>

    </div>

</section>

</body>
</html>
